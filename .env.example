# Obrigatório: Chave da API do Google Gemini
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua-chave-aqui

# Opcional: modelo Gemini (padrão: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Opcional: porta local (padrão: 3000)
PORT=3000

# Obrigatório para keep-alive 24/7 no servidor:
# URL pública da sua aplicação (sem barra no final)
# Exemplos:
#   Railway: https://duckbot-production-xxxx.up.railway.app
#   Render:  https://duckbot.onrender.com
#   Fly.io:  https://duckbot.fly.dev
APP_URL=https://sua-url-publica.exemplo.com

# Opcional: path do Chrome/Chromium (detectado automaticamente na maioria dos casos)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
